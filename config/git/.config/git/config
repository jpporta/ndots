[user]
	name = João Pedro Pin Porta
	email = jpedro.porta@gmail.com

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	program = gpg

[push]
	autoSetupRemote = true

# Per-host identity (email + signing key). On Macs nix-darwin writes it from
# custom.keys (modules/darwin/keys); a missing file is silently ignored, in
# which case gpg picks the key matching user.email.
[include]
	path = ~/.config/git/host.gitconfig
