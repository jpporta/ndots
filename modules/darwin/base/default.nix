{
  pkgs,
  lib,
  ...
}:

# Shared nix-darwin setup for every Mac (jpporta-mac, velozient-mac).
# Hosts only add identity (hostname, SSH/GPG key details) and extras on top.
#
# Dotfiles are NOT managed here: they live in ~/ndots/config/<pkg> and are
# linked with GNU stow (e.g. `cd ~/ndots/config && stow -t ~ nvim kitty zsh`).
let
  user = "jpporta";
  home = "/Users/${user}";

  # Public keys allowed to SSH into this Mac.
  authorizedKeys = [
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG8115XYzQTL/ZfAerfm2carlSsIDHN6qM/K5V+AQ0St Generated By Termius"
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKa1CY1Q09s7mVJXCGEOyRWmDJPsl1ZKOYwPJfmIXKLj jpedro.porta@gmail.com"
  ];
in
{
  imports = [
    ./packages.nix
    ./homebrew.nix
    ../keys
  ];

  # Nix configuration
  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];

  # Shell configuration
  programs.zsh.enable = true;

  # direnv + nix-direnv: per-repo `use flake` dev shells (cached, GC-rooted)
  programs.direnv = {
    enable = true;
    nix-direnv.enable = true;
    silent = true;
    # Hook is installed by config/zsh/.zshrc
    enableZshIntegration = false;
  };

  # User configuration
  system.primaryUser = user;
  users.users.${user} = {
    name = user;
    inherit home;
    shell = pkgs.zsh;
  };

  # Host platform & allow unfree packages
  nixpkgs.hostPlatform = lib.mkDefault "aarch64-darwin";
  nixpkgs.config.allowUnfree = true;

  # Security & sudo with Touch ID
  security.pam.services.sudo_local.touchIdAuth = true;

  # SSH daemon (Remote Login), key-only
  services.openssh = {
    enable = true;
    extraConfig = ''
      PasswordAuthentication no
      KbdInteractiveAuthentication no
    '';
  };

  # SSH authorized keys
  system.activationScripts.postActivation.text = ''
        echo "Setting up SSH authorized keys for ${user}..."
        mkdir -p ${home}/.ssh
        chmod 700 ${home}/.ssh
        cat > ${home}/.ssh/authorized_keys << 'EOF'
    ${lib.concatStringsSep "\n" authorizedKeys}
    EOF
        chmod 600 ${home}/.ssh/authorized_keys
        chown -R ${user}:staff ${home}/.ssh
  '';

  # SSH + GPG identities: hosts set the comments/email, `setup-keys` creates them.
  custom.keys = {
    enable = true;
    inherit user;
    ssh.type = "ed25519";
    gpg = {
      name = "João Pedro Pin Porta";
      algorithm = "ed25519";
      usage = "sign";
      expire = "1y";
    };
  };

  environment.variables = {
    EDITOR = "nvim";
    # podman machines run on libkrun (krunkit, see homebrew.nix)
    CONTAINERS_MACHINE_PROVIDER = "libkrun";
  };

  # State version
  system.stateVersion = 5;
}
